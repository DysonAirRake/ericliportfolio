---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import home from '../data/home.json';

const all = await getCollection('projects');
const bySlug = Object.fromEntries(all.map((p) => [p.id, p]));
// featured = exactly the list in home.json, in that order
const featured = home.featured.map((s) => bySlug[s]).filter(Boolean);
// more work = the explicit ordered list in home.json
const rest = (home.moreWork || []).map((s) => bySlug[s]).filter(Boolean);
---
<Base>
  <Hero />

  <section id="work" class="best">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="num">01 — Featured</span>
        <h2>Featured work</h2>
        <p>4 projects that show the best range of my capabilities and how I turned concepts into reality.</p>
      </div>
      {featured.map((p, i) => <FeatureBlock project={p.data} slug={p.id} index={i} />)}
    </div>
  </section>

  <section class="more">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="num">02 — Archive</span>
        <h2>More Work</h2>
        <p>Selected quality work from personal ambitions, co-ops, design teams, or coursework.</p>
      </div>
      <div class="grid">
        {rest.map((p) => <ProjectCard project={p.data} slug={p.id} />)}
      </div>
    </div>
  </section>

  <section id="about" class="about">
    <div class="wrap about-in" data-reveal>
      <div class="portrait"><img src="/media/site/headshot.jpg" alt="Eric Li" /></div>
      <div class="about-text">
        <span class="num">03 — About</span>
        <h2>Versatile engineering.</h2>
        <p>I'm a University of Toronto Mechanical Engineering graduate (3.9 CGPA, Robotics &amp; Mechatronics minor)
          and a Certified SOLIDWORKS Professional in Mechanical Design. I enjoy problems that run from first sketch
          to on-site testing. I don't give up until what you see on a screen comes to fruition outside of one.</p>
        <div class="skills">
          <div><span>Design &amp; CAD</span>SOLIDWORKS · Inventor · Fusion 360 · AutoCAD · Revit · GD&amp;T</div>
          <div><span>Analysis &amp; Simulation</span>FEA (ANSYS/Autodesk) · MATLAB · LabVIEW · SPICE · Minitab</div>
          <div><span>Industrial</span>Servo motors/valves · Hydraulics · Weldments · Lathe/Mill · Soldering · Arduino</div>
          <div><span>Software</span>Python · C++ · Java · HTML/CSS · Figma · MS Office</div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .best .section-head{max-width:var(--maxw)}
  .best .feature:first-of-type{border-top:1px solid var(--line)}
  .more{background:var(--bg-alt)}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.grid{grid-template-columns:1fr}}

  .about-in{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(30px,5vw,70px);align-items:center}
  .portrait{border-radius:var(--radius);overflow:hidden;background:var(--bg-alt);aspect-ratio:4/5;
    box-shadow:0 30px 60px -34px rgba(15,25,55,.4)}
  .portrait img{width:100%;height:100%;object-fit:cover;object-position:center}
  .about-text .num{font-family:var(--font-display);color:var(--muted);font-size:.72rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase}
  .about-text h2{font-size:clamp(1.9rem,4vw,3rem);margin-top:12px;letter-spacing:-.03em}
  .about-text>p{color:var(--ink-soft);margin-top:18px;font-size:1.08rem;max-width:52ch}
  .skills{display:grid;grid-template-columns:1fr 1fr;gap:18px 30px;margin-top:30px}
  .skills div{font-size:.95rem;color:var(--ink-soft)}
  .skills span{display:block;font-family:var(--font-display);font-size:.72rem;letter-spacing:.14em;
    text-transform:uppercase;color:var(--accent);margin-bottom:6px}
  @media(max-width:760px){.about-in{grid-template-columns:1fr}.portrait{max-width:320px}}
</style>
