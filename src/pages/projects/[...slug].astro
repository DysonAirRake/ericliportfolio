---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      project: entry.data,
      slug: entry.id,
      prev: i > 0 ? { slug: all[i - 1].id, title: all[i - 1].data.title } : null,
      next: i < all.length - 1 ? { slug: all[i + 1].id, title: all[i + 1].data.title } : null,
    },
  }));
}
const { project, slug, prev, next } = Astro.props;
---
<ProjectLayout project={project} slug={slug} prev={prev} next={next} />
