---
// Renders a project's modular `sections`. Image/video filenames resolve to the
// project's own folder: /media/projects/<slug>/<file>
const { sections = [], slug } = Astro.props;
const base = `/media/projects/${slug}/`;
---
<div class="body-flow">
  {sections.map((s) => {
    if (s.type === 'lead')
      return <p class="lead" data-reveal>{s.body}</p>;

    if (s.type === 'text')
      return (
        <div class="block text" data-reveal>
          {s.heading && <h3>{s.heading}</h3>}
          <p>{s.body}</p>
        </div>
      );

    if (s.type === 'full')
      return (
        <figure class="block full" data-reveal>
          <img src={base + s.src} alt={s.alt} loading="lazy" />
          {s.caption && <figcaption>{s.caption}</figcaption>}
        </figure>
      );

    if (s.type === 'pair')
      return (
        <figure class="block pair" data-reveal>
          <div class="two">
            <img src={base + s.a.img} alt={s.a?.alt} loading="lazy" />
            <img src={base + s.b.img} alt={s.b?.alt} loading="lazy" />
          </div>
          {s.caption && <figcaption>{s.caption}</figcaption>}
        </figure>
      );

    if (s.type === 'video')
      return (
        <figure class="block full" data-reveal>
          <video src={base + s.src} poster={s.poster ? base + s.poster : undefined}
                 controls muted loop playsinline></video>
          {s.caption && <figcaption>{s.caption}</figcaption>}
        </figure>
      );
    return null;
  })}
</div>

<style>
  .body-flow{max-width:800px;margin:0 auto}
  .lead{font-size:clamp(1.15rem,2.2vw,1.5rem);line-height:1.5;color:var(--ink);
    font-family:var(--font-display);font-weight:500;letter-spacing:-.01em;
    padding-block:clamp(28px,4vw,46px)}
  .block{margin-block:clamp(26px,4vw,52px)}
  .text h3{font-size:clamp(1.35rem,2.6vw,1.85rem);margin-bottom:14px;letter-spacing:-.02em}
  .text p{font-size:1.05rem;color:var(--ink-soft)}
  figure.full img,figure.full video{width:100%;max-height:76vh;object-fit:cover;border-radius:var(--radius);background:var(--bg-alt)}
  .pair .two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .pair img{width:100%;height:100%;object-fit:cover;border-radius:var(--radius);background:var(--bg-alt);aspect-ratio:4/3}
  figcaption{color:var(--muted);font-size:.86rem;margin-top:14px;text-align:center;font-style:italic}

  figure.full,figure.pair{width:min(1060px,92vw);margin-inline:calc(50% - min(530px,46vw));}
  @media(max-width:820px){
    figure.full,figure.pair{width:100%;margin-inline:0}
    .pair .two{grid-template-columns:1fr}
  }
</style>
