---
// Compact clickable media cards -> lightbox with full media + description.
const { media = [], slug, heading = 'Gallery' } = Astro.props;
const base = `/media/projects/${slug}/`;
const src = (m) => base + (m.video || m.img);
const poster = (m) => (m.poster ? base + m.poster : m.img ? base + m.img : '');
---
{media.length > 0 && (
<section class="gallery"><div class="wrap" data-reveal>
  <div class="section-head"><span class="num">Gallery</span><h2>{heading}</h2></div>
  <div class="grid">
    {media.map((m, i) => (
      <button class="gcard" data-i={i}
        data-type={m.video ? 'video' : 'image'} data-src={src(m)} data-poster={poster(m)}
        data-title={m.title} data-desc={m.desc || ''}>
        <img src={poster(m)} alt={m.title} loading="lazy" />
        {m.video && <span class="play">▶</span>}
        <span class="cap"><b>{m.title}</b>{m.subtitle && <em>{m.subtitle}</em>}</span>
      </button>
    ))}
  </div>
</div>

<div class="lb" id="lb-{slug}" hidden>
  <button class="lb-close" aria-label="Close">✕</button>
  <button class="lb-nav prev" aria-label="Previous">‹</button>
  <button class="lb-nav next" aria-label="Next">›</button>
  <div class="lb-stage"></div>
  <div class="lb-meta"><b></b><p></p></div>
</div>
</section>
)}

<style>
  .gallery{padding-block:clamp(24px,3.2vw,42px)}
  .gallery .section-head{margin-bottom:clamp(14px,2vw,22px)}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .gcard{position:relative;border:0;padding:0;cursor:pointer;border-radius:var(--radius);overflow:hidden;
    background:var(--bg-alt);aspect-ratio:4/3;display:block;box-shadow:0 16px 40px -28px rgba(15,25,55,.4);
    transition:transform .25s}
  .gcard:hover{transform:translateY(-4px)}
  .gcard>img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .gcard:hover>img{transform:scale(1.06)}
  .gcard .play{position:absolute;inset:0;margin:auto;width:52px;height:52px;border-radius:50%;
    background:rgba(0,0,0,.5);color:#fff;display:grid;place-items:center;font-size:18px;padding-left:3px}
  .gcard .cap{position:absolute;left:0;right:0;bottom:0;padding:26px 16px 14px;text-align:left;
    background:linear-gradient(transparent,rgba(6,9,15,.86));color:#fff}
  .gcard .cap b{display:block;font-family:var(--font-display);font-weight:600;font-size:1.15rem;letter-spacing:-.01em}
  .gcard .cap em{font-style:normal;font-size:.78rem;color:rgba(255,255,255,.82)}
  @media(max-width:820px){.grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:520px){.grid{grid-template-columns:1fr}}

  .lb{position:fixed;inset:0;z-index:1000;background:rgba(6,8,12,.92);display:flex;flex-direction:column;
    align-items:center;justify-content:center;padding:clamp(16px,4vw,60px);gap:16px}
  .lb[hidden]{display:none}
  .lb-stage{max-width:min(1100px,92vw);max-height:74vh;display:flex}
  .lb-stage img,.lb-stage video{max-width:100%;max-height:74vh;border-radius:10px;object-fit:contain;background:#000}
  .lb-meta{color:#fff;text-align:center;max-width:60ch}
  .lb-meta b{font-family:var(--font-display);font-size:1.2rem}
  .lb-meta p{color:rgba(255,255,255,.72);font-size:.95rem;margin-top:6px}
  .lb-close{position:absolute;top:18px;right:22px;background:none;border:0;color:#fff;font-size:26px;cursor:pointer;opacity:.8}
  .lb-close:hover{opacity:1}
  .lb-nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.12);border:0;color:#fff;
    width:48px;height:48px;border-radius:50%;font-size:28px;cursor:pointer;line-height:1}
  .lb-nav:hover{background:rgba(255,255,255,.24)}
  .lb-nav.prev{left:18px}.lb-nav.next{right:18px}
  @media(max-width:520px){.lb-nav{width:40px;height:40px;font-size:22px}}
</style>

<script>
  document.querySelectorAll('.gallery').forEach((g) => {
    const cards = [...g.querySelectorAll('.gcard')];
    const lb = g.querySelector('.lb');
    if (!lb || !cards.length) return;
    const stage = lb.querySelector('.lb-stage');
    const mb = lb.querySelector('.lb-meta b'), mp = lb.querySelector('.lb-meta p');
    let cur = 0;
    const render = (i) => {
      cur = (i + cards.length) % cards.length;
      const c = cards[cur];
      const t = c.dataset.type, s = c.dataset.src, p = c.dataset.poster;
      stage.innerHTML = t === 'video'
        ? `<video src="${s}" poster="${p}" controls autoplay muted playsinline></video>`
        : `<img src="${s}" alt="">`;
      mb.textContent = c.dataset.title; mp.textContent = c.dataset.desc;
    };
    const open = (i) => { render(i); lb.hidden = false; document.body.style.overflow = 'hidden'; };
    const close = () => { lb.hidden = true; stage.innerHTML = ''; document.body.style.overflow = ''; };
    cards.forEach((c, i) => c.addEventListener('click', () => open(i)));
    lb.querySelector('.lb-close').addEventListener('click', close);
    lb.querySelector('.prev').addEventListener('click', () => render(cur - 1));
    lb.querySelector('.next').addEventListener('click', () => render(cur + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') render(cur + 1);
      if (e.key === 'ArrowLeft') render(cur - 1);
    });
  });
</script>
