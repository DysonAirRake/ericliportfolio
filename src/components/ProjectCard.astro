---
const d = Astro.props.project;
const s = Astro.props.slug;
const base = `/media/projects/${s}/`;
// Default lead slide = this project's OWN page hero: its showcase hero video if it has one,
// otherwise its hero thumbnail (card). Any explicit cardMedia slides follow, de-duplicated.
const heroSlide = (d.showcase && d.showcase.video)
  ? { video: d.showcase.video, poster: d.showcase.poster || d.card }
  : { img: d.card };
const heroKey = heroSlide.video || heroSlide.img;
const extra = (d.cardMedia || []).filter((m) => (m.video || m.img) !== heroKey);
const slides = [heroSlide, ...extra];
---
<a class="card" href={`/projects/${s}/`} data-reveal>
  <div class="thumb">
    <div class="slides">
      {slides.map((m, i) => (
        <div class={"slide" + (i === 0 ? ' on' : '')}>
          {m.video
            ? <video src={base + m.video} poster={m.poster ? base + m.poster : undefined} autoplay muted loop playsinline></video>
            : <img src={base + m.img} alt={d.title} loading="lazy" />}
        </div>
      ))}
    </div>
    {slides.length > 1 && (
      <div class="cdots">{slides.map((m, i) => <span class={"cdot" + (i===0?' on':'')}></span>)}</div>
    )}
    {slides.length > 1 && (
      <>
        <span class="carrow cprev" role="button" tabindex="-1" aria-label="Previous slide">&#8249;</span>
        <span class="carrow cnext" role="button" tabindex="-1" aria-label="Next slide">&#8250;</span>
      </>
    )}
  </div>
  <div class="body">
    <p class="kicker">{d.discipline}</p>
    <h4>{d.title}</h4>
    <p class="sum">{d.summary}</p>
    <div class="tags">{d.tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}</div>
  </div>
  <span class="go">&rarr;</span>
</a>

<style>
  .card{position:relative;display:flex;flex-direction:column;background:var(--bg);
    border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:.25s}
  .card:hover{transform:translateY(-5px);box-shadow:0 26px 50px -28px rgba(15,25,55,.4);border-color:#d6dbe6}
  .thumb{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--bg-alt)}
  .slides{position:absolute;inset:0}
  .slide{position:absolute;inset:0;opacity:0;transition:opacity .6s ease}
  .slide.on{opacity:1}
  .slide img,.slide video{width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .card:hover .slide img{transform:scale(1.05)}
  .cdots{position:absolute;bottom:10px;left:0;right:0;display:flex;justify-content:center;gap:6px;z-index:2}
  .cdot{width:16px;height:3px;border-radius:3px;background:rgba(255,255,255,.55);transition:.3s}
  .cdot.on{background:#fff;width:22px}
  .carrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:36px;height:36px;
    border-radius:50%;background:rgba(255,255,255,.92);color:var(--ink);font-size:20px;line-height:1;cursor:pointer;
    display:grid;place-items:center;box-shadow:0 4px 14px -4px rgba(15,25,55,.5);opacity:.9;transition:.2s;padding-bottom:2px;user-select:none}
  .carrow:hover{opacity:1;background:#fff;transform:translateY(-50%) scale(1.08)}
  .carrow.cprev{left:10px}
  .carrow.cnext{right:10px}
  .body{padding:20px 20px 22px}
  .kicker{font-size:.64rem}
  .body h4{font-size:1.22rem;margin:12px 0 0;letter-spacing:-.02em}
  .sum{color:var(--muted);font-size:.9rem;margin-top:9px;line-height:1.5}
  .tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:15px}
  .tags .chip{font-size:.68rem;padding:4px 10px}
  .go{position:absolute;top:16px;right:16px;width:34px;height:34px;border-radius:50%;
    background:rgba(255,255,255,.9);display:grid;place-items:center;font-weight:700;color:var(--ink);
    opacity:0;transform:translateY(-4px);transition:.25s}
  .card:hover .go{opacity:1;transform:none}
</style>

<script>
  document.querySelectorAll('.card .thumb').forEach((t) => {
    const slides = [...t.querySelectorAll('.slide')];
    const dots = [...t.querySelectorAll('.cdot')];
    if (slides.length < 2) return;
    let i = 0, timer = null;
    const go = (n) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('on', k === i));
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
    };
    const start = () => { stop(); timer = setInterval(() => go(i + 1), 3400); };
    const stop = () => { if (timer) clearInterval(timer); timer = null; };
    // arrows sit inside the card's <a>; cancel the click so they flip slides instead of navigating
    const step = (e, dir) => { e.preventDefault(); e.stopPropagation(); go(i + dir); start(); };
    t.querySelector('.cprev')?.addEventListener('click', (e) => step(e, -1));
    t.querySelector('.cnext')?.addEventListener('click', (e) => step(e, 1));
    start();
  });
</script>
