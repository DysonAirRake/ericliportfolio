---
import Icon from './Icon.astro';
const proj = Astro.props.project;
const s = Astro.props.slug;
const idx = Astro.props.index;
const base = `/media/projects/${s}/`;
const slides = (proj.gallery && proj.gallery.length) ? proj.gallery : [{ img: proj.card }];
const flip = idx % 2 === 1;
---
<article class={"feature" + (flip ? ' flip' : '')} data-reveal>
  <div class="media">
    <div class="slides">
      {slides.map((sl, i) => (
        <a class={"slide" + (i === 0 ? ' is-active' : '')} href={`/projects/${s}/`}>
          {sl.video
            ? <video src={base + sl.video} poster={sl.poster ? base + sl.poster : undefined} autoplay muted loop playsinline></video>
            : <img src={base + sl.img} alt={sl.alt || proj.title} loading="lazy" />}
        </a>
      ))}
    </div>
    <span class="idx">{String(idx + 1).padStart(2, '0')}</span>
    {slides.length > 1 && (
      <div class="fdots">
        {slides.map((sl, i) => <button class={"fdot" + (i===0?' on':'')} data-i={i} aria-label="slide"></button>)}
      </div>
    )}
    {slides.length > 1 && (
      <>
        <button class="farrow fprev" type="button" aria-label="Previous slide">&#8249;</button>
        <button class="farrow fnext" type="button" aria-label="Next slide">&#8250;</button>
      </>
    )}
  </div>

  <div class="text">
    <p class="kicker">{proj.discipline}</p>
    <h3><a href={`/projects/${s}/`}>{proj.title}</a></h3>
    <p class="blurb">{proj.blurb || proj.summary}</p>
    {proj.highlights?.length > 0 && (
      <div class="mini">
        {proj.highlights.slice(0,3).map((h) => (
          <div class="m"><span class="mi"><Icon name={h.icon} size={22} /></span><b set:html={h.value.replace(/\//g, '/&#8203;')}></b><span class="ml">{h.label}</span></div>
        ))}
      </div>
    )}
    <div class="f-actions">
      <a class="arrow-link" href={`/projects/${s}/`}>View project<span>&rarr;</span></a>
      {proj.crossLink && <a class="cross" href={`/projects/${proj.crossLink.slug}/`}>{proj.crossLink.label}<span>&rarr;</span></a>}
    </div>
  </div>
</article>

<style>
  .feature{display:grid;grid-template-columns:1.4fr .78fr;gap:clamp(22px,2.4vw,40px);align-items:center;
    padding-block:clamp(26px,3.5vw,44px);border-top:1px solid var(--line)}
  .feature.flip{grid-template-columns:.78fr 1.4fr}
  .media{position:relative;border-radius:var(--radius);overflow:hidden;background:var(--bg-alt);
    aspect-ratio:3/2;box-shadow:0 22px 50px -30px rgba(15,25,55,.35)}
  .slides{position:absolute;inset:0}
  .slide{position:absolute;inset:0;opacity:0;transition:opacity .7s ease}
  .slide.is-active{opacity:1}
  .slide img,.slide video{width:100%;height:100%;object-fit:cover}
  .idx{position:absolute;left:16px;top:10px;font-family:var(--font-display);font-weight:700;
    font-size:2rem;color:rgba(255,255,255,.92);text-shadow:0 2px 18px rgba(0,0,0,.5)}
  .fdots{position:absolute;bottom:14px;left:0;right:0;display:flex;justify-content:center;gap:8px;z-index:2}
  .fdot{width:22px;height:3px;border:0;border-radius:3px;background:rgba(255,255,255,.5);cursor:pointer;transition:.3s;padding:0}
  .fdot.on{background:#fff;width:32px}
  .farrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:40px;height:40px;border:0;
    border-radius:50%;background:rgba(255,255,255,.92);color:var(--ink);font-size:22px;line-height:1;cursor:pointer;
    display:grid;place-items:center;box-shadow:0 4px 16px -4px rgba(15,25,55,.55);opacity:.9;transition:.2s;padding-bottom:2px}
  .farrow:hover{opacity:1;background:#fff;transform:translateY(-50%) scale(1.08)}
  .farrow.fprev{left:12px}
  .farrow.fnext{right:12px}
  .flip .media{order:2}

  .text h3{font-size:clamp(1.6rem,3vw,2.5rem);margin:14px 0 0;letter-spacing:-.03em}
  .blurb{color:var(--ink-soft);margin-top:13px;font-size:1rem;max-width:44ch}
  .mini{display:grid;grid-template-columns:repeat(3,1fr);gap:20px 14px;margin-top:22px}
  .m{display:flex;flex-direction:column;gap:2px;min-width:0}
  .m .mi{color:var(--accent);margin-bottom:6px}
  .m b{font-family:var(--font-display);font-weight:600;font-size:1.18rem;letter-spacing:-.02em;line-height:1.15;overflow-wrap:break-word}
  .m .ml{color:var(--muted);font-size:.76rem;line-height:1.3}
  .f-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:22px}
  .cross{display:inline-flex;align-items:center;gap:.5em;font-family:var(--font-display);font-weight:600;
    font-size:.82rem;padding:8px 15px;border:1px solid var(--line);border-radius:100px;color:var(--ink-soft);transition:.2s}
  .cross:hover{border-color:var(--accent);color:var(--accent)}

  @media(max-width:820px){
    .feature,.feature.flip{grid-template-columns:1fr;gap:20px}
    .flip .media{order:0}
  }
</style>

<script>
  document.querySelectorAll('.feature').forEach((f) => {
    const slides = [...f.querySelectorAll('.slide')];
    const dots = [...f.querySelectorAll('.fdot')];
    if (slides.length < 2) return;
    let i = 0, t = null;
    const show = (n) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
    };
    const start = () => { stop(); t = setInterval(() => show(i + 1), 3800); };
    const stop = () => { if (t) clearInterval(t); t = null; };
    dots.forEach((d) => d.addEventListener('click', (e) => { e.preventDefault(); show(Number(d.dataset.i)); start(); }));
    f.querySelector('.fprev')?.addEventListener('click', (e) => { e.preventDefault(); show(i - 1); start(); });
    f.querySelector('.fnext')?.addEventListener('click', (e) => { e.preventDefault(); show(i + 1); start(); });
    start();
  });
</script>
