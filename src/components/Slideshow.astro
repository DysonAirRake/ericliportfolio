---
// Inline slideshow: cycles media; videos show a poster + play button. Clicking any slide opens
// the shared page lightbox (#slb) scoped to this slideshow's items (see ProjectLayout script).
const { items = [], base, ratio = '16 / 10' } = Astro.props;
const src = (m) => base + (m.video || m.img);
const poster = (m) => (m.poster ? base + m.poster : (m.img ? base + m.img : ''));
---
<div class="show" data-show style={`--ratio:${ratio}`}>
  <div class="show-frame">
    {items.map((m, i) => (
      <button class={"show-slide" + (i === 0 ? ' on' : '')} data-i={i}
        data-type={m.video ? 'video' : 'image'} data-src={src(m)} data-poster={poster(m)}
        data-title={m.title || ''} data-cap={m.caption || ''} aria-label={m.title || 'View media'}>
        <img src={poster(m)} alt={m.title || ''} loading="lazy" />
        {m.video && <span class="show-play">&#9654;</span>}
        {(m.title || m.caption) && <span class="show-cap"><b>{m.title}</b>{m.caption && <em>{m.caption}</em>}</span>}
      </button>
    ))}
    {items.length > 1 && (
      <>
        <button class="show-nav sprev" type="button" aria-label="Previous slide">&#8249;</button>
        <button class="show-nav snext" type="button" aria-label="Next slide">&#8250;</button>
      </>
    )}
  </div>
  {items.length > 1 && (
    <div class="show-dots">{items.map((m, i) => <span class={"sdot" + (i === 0 ? ' on' : '')}></span>)}</div>
  )}
</div>

<style>
  .show{display:flex;flex-direction:column;gap:12px}
  .show-frame{position:relative;aspect-ratio:var(--ratio);border-radius:var(--radius);overflow:hidden;
    background:var(--bg-alt);border:1px solid var(--line);box-shadow:0 20px 46px -30px rgba(15,25,55,.4)}
  .show-slide{position:absolute;inset:0;border:0;padding:0;cursor:pointer;opacity:0;transition:opacity .55s ease;background:#0c0f15}
  .show-slide.on{opacity:1}
  .show-slide>img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
  .show-slide:hover>img{transform:scale(1.03)}
  .show-play{position:absolute;inset:0;margin:auto;width:60px;height:60px;border-radius:50%;
    background:rgba(0,0,0,.55);color:#fff;display:grid;place-items:center;font-size:20px;padding-left:4px;
    box-shadow:0 6px 20px -6px rgba(0,0,0,.5)}
  .show-cap{position:absolute;left:0;right:0;bottom:0;padding:26px 16px 13px;text-align:left;
    background:linear-gradient(transparent,rgba(6,9,15,.86));color:#fff;pointer-events:none}
  .show-cap b{display:block;font-family:var(--font-display);font-weight:600;font-size:1.02rem;letter-spacing:-.01em}
  .show-cap em{font-style:normal;font-size:.78rem;color:rgba(255,255,255,.82)}
  .show-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:40px;height:40px;border:0;
    border-radius:50%;background:rgba(255,255,255,.86);color:var(--ink);font-size:22px;line-height:1;cursor:pointer;
    display:grid;place-items:center;box-shadow:0 6px 18px -6px rgba(15,25,55,.5);opacity:.9;transition:.2s;padding-bottom:2px}
  .show-nav:hover{opacity:1;background:#fff;transform:translateY(-50%) scale(1.08)}
  .show-nav.sprev{left:12px}
  .show-nav.snext{right:12px}
  .show-dots{display:flex;justify-content:center;gap:7px}
  .sdot{width:20px;height:3px;border-radius:3px;background:var(--line);transition:.3s}
  .sdot.on{background:var(--accent);width:28px}
</style>
