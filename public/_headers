# Content-hashed build assets never change — cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media (images/videos) — cache 30 days. Bump a filename or purge cache to update.
/media/*
  Cache-Control: public, max-age=2592000

# The résumé PDF — cache 1 day so updates show quickly.
/resume.pdf
  Cache-Control: public, max-age=86400
